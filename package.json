{
  "name": "carbon-mvp",
  "version": "0.1.0",
  "description": "Permissioned blockchain prototype for granular product carbon tracking (dissertation research demonstrator)",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "network:up": "docker compose -f network/docker-compose.yml up -d",
    "network:down": "docker compose -f network/docker-compose.yml down",
    "network:reset": "docker compose -f network/docker-compose.yml down -v",
    "network:health": "node network/check-health.js",
    "network:health:full": "node network/check-health.js --full",
    "deploy:besu": "hardhat run simulation/deploy.ts --network besu",
    "simulate": "hardhat run simulation/run-lifecycle.ts --network besu",
    "synthetic:generate": "node simulation/synthetic/generate.js",
    "simulate:synthetic": "hardhat run simulation/run-lifecycle-synthetic.ts --network besu",
    "baselines": "hardhat run baselines/load-baselines.ts --network besu",
    "audit": "hardhat run audit/provenance.ts --network besu",
    "study:a": "hardhat run evaluation/study-a-tampering/run-study-a.ts --network besu",
    "study:b": "hardhat run evaluation/study-b-aggregation/run-study-b.ts --network besu",
    "study:c:bench4": "hardhat run evaluation/study-c-performance/bench-driver.ts --network besu",
    "study:c:setup7": "node evaluation/study-c-performance/setup-network7.js",
    "study:c:bench7": "hardhat run evaluation/study-c-performance/bench-driver.ts --network besu7",
    "study:c:report": "node evaluation/study-c-performance/make-report.js",
    "results:build": "node dissertation-results/build.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "sharp": "^0.35.3",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  }
}
